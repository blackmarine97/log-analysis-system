// Version resource. Besides being good manners for a shipped exe, metadata
// like this measurably lowers the false-positive rate of antivirus ML
// heuristics (Defender's Wacatac.B!ml flags anonymous unsigned binaries).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Changbae Son"
            VALUE "FileDescription",  "Log Analysis Client - uploads a device log to the analysis server and retrieves result.csv"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "log_client"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Changbae Son"
            VALUE "OriginalFilename", "log_client.exe"
            VALUE "ProductName",      "Large-Scale Log Analysis and Transfer System"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
